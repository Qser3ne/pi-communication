{
  "name": "pi-communication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local peer messaging for independent Pi sessions",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "typebox": "1.3.27",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "tsx": "^4.20.0"
  }
}
